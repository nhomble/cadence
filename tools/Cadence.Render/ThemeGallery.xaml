<UserControl x:Class="Cadence.App.UI.Views.ThemeGallery" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <!-- Every styled control in one place (the "theme" render state): a visual check of the templates, not a screen of the product. -->
  <UserControl.Resources>
    <Style x:Key="Swatch" TargetType="Border">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
      <Setter Property="Margin" Value="0,16,0,6" />
    </Style>
  </UserControl.Resources>
  <Grid Margin="32,20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="40" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel>
      <TextBlock Text="Tokyo Night" Style="{StaticResource Heading1}" />
      <TextBlock Text="Type" Style="{StaticResource Label}" />
      <TextBlock Text="15 semibold: panel titles" FontSize="15" FontWeight="SemiBold" />
      <TextBlock Text="13: body, table rows, inputs" Margin="0,4,0,0" />
      <TextBlock Text="12: labels, headers, the status bar, secondary text" Style="{StaticResource Dim}" FontSize="12" Margin="0,4,0,0" />
      <TextBlock Text="*/15 9-17 * * 1-5   C:\Tools\backup.exe --all" Style="{StaticResource Mono}" Margin="0,4,0,0" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" FontSize="14" />
        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;" FontSize="14" Margin="12,0,0,0" />
        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" FontSize="14" Margin="12,0,0,0" />
        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" FontSize="14" Margin="12,0,0,0" />
        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72E;" FontSize="14" Margin="12,0,0,0" />
        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE712;" FontSize="14" Margin="12,0,0,0" />
        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70E;" FontSize="14" Margin="12,0,0,0" />
        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70D;" FontSize="14" Margin="12,0,0,0" />
        <TextBlock Text="Segoe MDL2 Assets" Style="{StaticResource Dim}" Margin="14,0,0,0" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock Text="Palette" Style="{StaticResource Label}" />
      <WrapPanel>
        <Border Style="{StaticResource Swatch}" Background="{StaticResource BgBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource SurfaceBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource HighlightBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource BorderBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource FgBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource DimTextBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource DimBrush}" />
      </WrapPanel>
      <WrapPanel>
        <Border Style="{StaticResource Swatch}" Background="{StaticResource BlueBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource CyanBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource PurpleBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource GreenBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource YellowBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource OrangeBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource RedBrush}" />
      </WrapPanel>
      <WrapPanel>
        <Border Style="{StaticResource Swatch}" Background="{StaticResource RowHoverBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource RowSelectedBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource RowSelectedInactiveBrush}" />
        <Border Style="{StaticResource Swatch}" Background="{StaticResource DividerBrush}" />
      </WrapPanel>

      <TextBlock Text="Buttons" Style="{StaticResource Label}" />
      <StackPanel Orientation="Horizontal">
        <Button Content="Cancel" />
        <Button Content="Save" Style="{StaticResource Primary}" Margin="8,0,0,0" />
        <Button Content="Back" Style="{StaticResource Ghost}" Margin="8,0,0,0" />
        <Button Content="Delete" Style="{StaticResource Danger}" Margin="8,0,0,0" />
        <Button Content="Disabled" IsEnabled="False" Margin="8,0,0,0" />
      </StackPanel>
      <TextBlock Text="Toolbar" Style="{StaticResource Label}" />
      <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="0,1" Padding="6,5">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ToolbarButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" Margin="0,0,6,0" /><TextBlock Text="New" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;" Margin="0,0,6,0" /><TextBlock Text="Run now" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" IsEnabled="False">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" Margin="0,0,6,0" /><TextBlock Text="Delete" /></StackPanel>
          </Button>
          <Border Width="1" Margin="6,4" Background="{StaticResource HighlightBrush}" />
          <Button Style="{StaticResource ToolbarButton}">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" Margin="0,0,6,0" /><TextBlock Text="Refresh" /></StackPanel>
          </Button>
          <Button Style="{StaticResource IconButton}" Margin="12,0,0,0"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE712;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" /></Button>
        </StackPanel>
      </Border>

      <TextBlock Text="Switch, segments, checkbox" Style="{StaticResource Label}" />
      <StackPanel Orientation="Horizontal">
        <ToggleButton Style="{StaticResource Switch}" IsChecked="True" Content="Enabled" />
        <ToggleButton Style="{StaticResource Switch}" IsChecked="False" Content="Run hidden" Margin="24,0,0,0" />
      </StackPanel>
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1" CornerRadius="4" Padding="3" HorizontalAlignment="Left" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal">
          <ToggleButton Style="{StaticResource Segment}" Content="Simple" IsChecked="True" />
          <ToggleButton Style="{StaticResource Segment}" Content="Cron" />
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <CheckBox Content="Skip holidays" IsChecked="True" />
        <CheckBox Content="Only between 9 and 17" Margin="24,0,0,0" />
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Column="2">
      <TextBlock Text=" " Style="{StaticResource Heading1}" />
      <TextBlock Text="Text box, combo box" Style="{StaticResource Label}" />
      <TextBox Text="Stock ingest (Dad)" />
      <TextBox Text="*/15 9-17 * * 1-5" Style="{StaticResource MonoTextBox}" Margin="0,8,0,0" />
      <ComboBox Margin="0,8,0,0" SelectedIndex="1">
        <ComboBoxItem Content="Every day" />
        <ComboBoxItem Content="Weekdays" />
        <ComboBoxItem Content="Every N minutes" />
      </ComboBox>

      <TextBlock Text="State in words, no dots" Style="{StaticResource Label}" />
      <WrapPanel>
        <TextBlock Text="Ok" Margin="0,0,18,4" />
        <TextBlock Text="Failed (exit 3)" Foreground="{StaticResource RedBrush}" Margin="0,0,18,4" />
        <TextBlock Text="Couldn't start (access denied)" Foreground="{StaticResource RedBrush}" Margin="0,0,18,4" />
        <TextBlock Text="Timed out" Foreground="{StaticResource OrangeBrush}" Margin="0,0,18,4" />
        <TextBlock Text="Changed in Task Scheduler" Foreground="{StaticResource YellowBrush}" Margin="0,0,18,4" />
        <TextBlock Text="Running now" Foreground="{StaticResource CyanBrush}" Margin="0,0,18,4" />
        <TextBlock Text="Skipped" Style="{StaticResource Dim}" Margin="0,0,18,4" />
        <TextBlock Text="Disabled" Style="{StaticResource Dim}" Margin="0,0,18,4" />
      </WrapPanel>

      <TextBlock Text="Table" Style="{StaticResource Label}" />
      <ListView x:Name="Sample" Style="{StaticResource GridTable}" Height="150" SelectedIndex="1" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1">
        <ListView.View>
          <GridView ColumnHeaderContainerStyle="{StaticResource GridHeader}">
            <GridViewColumn Header="Name" Width="130">
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource Cell}" Margin="8,0" /></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Rate" Width="90">
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Rate}" Style="{StaticResource CellDim}" Margin="8,0" /></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Header="Last result" Width="240">
              <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Result}" Style="{StaticResource Cell}" Margin="8,0" /></DataTemplate></GridViewColumn.CellTemplate>
            </GridViewColumn>
          </GridView>
        </ListView.View>
      </ListView>

      <TextBlock Text="List box, expander" Style="{StaticResource Label}" />
      <ListBox SelectedIndex="1" Height="88">
        <ListBoxItem Content="Good morning" />
        <ListBoxItem Content="End of day" />
        <ListBoxItem Content="On the hour" />
      </ListBox>
      <Expander Header="Other Task Scheduler tasks" IsExpanded="True" Margin="0,8,0,0">
        <TextBlock Text="Read-only rows go here." Style="{StaticResource Dim}" Margin="22,4,0,0" />
      </Expander>
    </StackPanel>
  </Grid>
</UserControl>

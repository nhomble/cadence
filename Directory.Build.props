<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)obj\artifacts</ArtifactsPath>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.0.0</Version>
    <InformationalVersion>dev</InformationalVersion>
    <Product>Cadence</Product>
    <Company>Cadence</Company>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)obj\Version.g.props" Condition="Exists('$(MSBuildThisFileDirectory)obj\Version.g.props')" />
</Project>

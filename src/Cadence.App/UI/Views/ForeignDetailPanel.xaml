<UserControl x:Class="Cadence.App.UI.Views.ForeignDetailPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <StackPanel Margin="28,26,28,24">
    <TextBlock x:Name="TitleText" Style="{StaticResource Heading1}" TextWrapping="Wrap" AutomationProperties.Name="Task name" />
    <TextBlock x:Name="PathText" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,5,0,0" />
    <Border Height="1" Background="{StaticResource HighlightBrush}" Margin="0,18,0,10" />
    <ItemsControl x:Name="RowsList" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="104" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="NoteText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="CloseButton" Content="Close" Click="OnClose" IsCancel="True" MinWidth="92" AutomationProperties.Name="Close" />
      <Button x:Name="OpenButton" Style="{StaticResource Primary}" Content="Open in Task Scheduler" Click="OnOpen" IsDefault="True" MinWidth="92" Margin="10,0,0,0"
              AutomationProperties.Name="Open in Task Scheduler" />
    </StackPanel>
  </StackPanel>
</UserControl>

<UserControl x:Class="Cadence.App.UI.Views.TemplateCards" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Cadence.App.UI.Views"
             xmlns:vm="clr-namespace:Cadence.App.UI.ViewModels;assembly=Cadence.Presentation"
             KeyboardNavigation.TabNavigation="Continue">
  <UserControl.Resources>
    <views:BrushKeyConverter x:Key="BrushKey" />
    <views:WidthToColumnsConverter x:Key="Columns" />

    <DataTemplate DataType="{x:Type vm:TemplateCardViewModel}">
      <Button Style="{StaticResource Card}" Command="{Binding PickCommand}" Margin="6" MinHeight="124" AutomationProperties.Name="{Binding Title}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Grid Width="12" Height="12" VerticalAlignment="Center" x:Name="PlusHost" Visibility="Collapsed">
              <Path x:Name="PlusMark" Data="M0,5 H10 M5,0 V10" Stroke="{StaticResource BlueBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="10" Height="10" />
            </Grid>
            <TextBlock x:Name="TitleText" Text="{Binding Title}" Style="{StaticResource Heading2}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,9,0,0" LineHeight="19" />
          <TextBlock Grid.Row="2" Text="{Binding Next}" Style="{StaticResource Small}" Foreground="{StaticResource BlueBrush}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsBlank}" Value="True">
          <Setter TargetName="PlusHost" Property="Visibility" Value="Visible" />
          <Setter TargetName="TitleText" Property="Margin" Value="9,0,0,0" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <!-- DataContext is the list of cards. -->
  <ItemsControl ItemsSource="{Binding}" Focusable="False">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Columns}}" />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
  </ItemsControl>
</UserControl>

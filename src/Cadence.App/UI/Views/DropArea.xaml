<UserControl x:Class="Cadence.App.UI.Views.DropArea" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The drop itself is handled by the whole window (FileDrop on MainView); this area is where the eye goes. -->
  <Grid Height="76" Margin="6,0">
    <Rectangle RadiusX="12" RadiusY="12" Stroke="{StaticResource BorderBrush}" StrokeThickness="1.5" StrokeDashArray="4 4" SnapsToDevicePixels="False" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Path Data="M7,0 V12 M2,7 L7,12 L12,7 M0,15 H14" Stroke="{StaticResource DimBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Width="14" Height="16" VerticalAlignment="Center" />
      <TextBlock Text="…or drop a program, shortcut or script here" Style="{StaticResource Dim}" Margin="14,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>

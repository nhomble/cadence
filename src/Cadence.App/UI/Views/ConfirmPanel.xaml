<UserControl x:Class="Cadence.App.UI.Views.ConfirmPanel" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <StackPanel Margin="28,26,28,24">
    <TextBlock x:Name="TitleText" Style="{StaticResource Heading1}" TextWrapping="Wrap" />
    <TextBlock x:Name="MessageText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="20" />
    <StackPanel x:Name="TypedBox" Margin="0,18,0,0" Visibility="Collapsed">
      <TextBlock x:Name="TypedHint" Style="{StaticResource Small}" Margin="0,0,0,6" />
      <TextBox x:Name="TypedText" TextChanged="OnTypedChanged" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsCancel="True" MinWidth="92" />
      <Button x:Name="ConfirmButton" Style="{StaticResource Primary}" Click="OnConfirm" IsDefault="True" MinWidth="92" Margin="10,0,0,0" />
    </StackPanel>
  </StackPanel>
</UserControl>

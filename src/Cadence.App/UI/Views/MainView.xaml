<UserControl x:Class="Cadence.App.UI.Views.MainView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Cadence.App.UI.Views"
             xmlns:vm="clr-namespace:Cadence.App.UI.ViewModels;assembly=Cadence.Presentation"
             xmlns:logic="clr-namespace:Cadence.App.UI.Logic;assembly=Cadence.Presentation"
             Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <DataTemplate DataType="{x:Type vm:ListPageViewModel}">
      <views:ListPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:EditorViewModel}">
      <views:EditorView />
    </DataTemplate>

    <views:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />

    <!-- [P23][P25] The agent switch as a flat text button in the status bar: DimText when agents are allowed, Orange when suspended, Red when the setting can't be read. No dot: the words say it. -->
    <Style x:Key="AgentSwitch" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="8,0">
              <TextBlock Text="{Binding PillText}" FontSize="12" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource HighlightBrush}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CyanBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding PillKind}" Value="Suspended"><Setter Property="Foreground" Value="{StaticResource OrangeBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding PillKind}" Value="Unreadable"><Setter Property="Foreground" Value="{StaticResource RedBrush}" /></DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PanelCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource BgBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="40,28" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Effect" Value="{StaticResource SoftShadow}" />
    </Style>

    <!-- [P23] A question drawn inside the window (never a separate window). -->
    <DataTemplate DataType="{x:Type vm:ChoicePanelViewModel}">
      <Border Style="{StaticResource PanelCard}" MaxWidth="520" AutomationProperties.AutomationId="ChoicePanel" AutomationProperties.Name="{Binding Title}">
        <StackPanel Margin="28,26,28,24">
          <TextBlock Text="{Binding Title}" Style="{StaticResource Heading1}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Message}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="20" />
          <ItemsControl ItemsSource="{Binding Buttons}" Focusable="False" Margin="0,24,0,0" HorizontalAlignment="Right">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="10,0,0,0">
                  <Button Content="{Binding Label}" Command="{Binding Command}" MinWidth="92" Visibility="{Binding IsPlain, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding Label}" />
                  <Button Content="{Binding Label}" Command="{Binding Command}" MinWidth="92" Style="{StaticResource Primary}" IsDefault="True"
                          Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding Label}" />
                  <Button Content="{Binding Label}" Command="{Binding Command}" MinWidth="92" Style="{StaticResource DangerPrimary}"
                          Visibility="{Binding IsDanger, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding Label}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- [P23] Agent activity: the newest agent log lines, newest first, plain words. -->
    <DataTemplate DataType="{x:Type vm:AgentActivityViewModel}">
      <Border Style="{StaticResource PanelCard}" MaxWidth="920" AutomationProperties.AutomationId="AgentActivityPanel" AutomationProperties.Name="Agent activity">
        <Grid Margin="28,24,28,22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <StackPanel>
              <TextBlock Text="Agent activity" Style="{StaticResource Heading1}" />
              <TextBlock Text="{Binding Header}" Style="{StaticResource Small}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0" ToolTip="Close (Esc)" AutomationProperties.Name="Close agent activity">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="10" Height="10" />
            </Button>
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource Dim}" TextWrapping="Wrap" LineHeight="20" Margin="0,22,0,10"
                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
          <Border Grid.Row="1" Margin="0,16,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="1" CornerRadius="6"
                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
            <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" Padding="0">
              <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="Agent log lines">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type logic:ActivityRow}">
                    <Border BorderBrush="{StaticResource HighlightBrush}" BorderThickness="0,0,0,1" Padding="16,9" ToolTip="{Binding Tooltip}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="122" />
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" MinWidth="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding When}" Style="{StaticResource Small}" VerticalAlignment="Top" Margin="0,2,0,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Who}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                          <TextBlock Text="{Binding What}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Result}" HorizontalAlignment="Right" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Top">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{StaticResource DimTextBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="Ok"><Setter Property="Foreground" Value="{StaticResource GreenBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Notice"><Setter Property="Foreground" Value="{StaticResource OrangeBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Problem"><Setter Property="Foreground" Value="{StaticResource RedBrush}" /></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="{StaticResource OrangeBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
          <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Path}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="{Binding Path}" AutomationProperties.Name="Agent log file" />
            <Button Grid.Column="1" Content="Open log folder" Style="{StaticResource LinkButton}" Command="{Binding OpenFolderCommand}" AutomationProperties.Name="Open log folder" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- [P23] What agents may do: the two limits. -->
    <DataTemplate DataType="{x:Type vm:AgentLimitsViewModel}">
      <Border Style="{StaticResource PanelCard}" MaxWidth="520" AutomationProperties.AutomationId="AgentLimitsPanel" AutomationProperties.Name="What AI agents may do">
        <StackPanel Margin="28,26,28,24">
          <Grid>
            <TextBlock Text="{x:Static vm:AgentLimitsText.Title}" Style="{StaticResource Heading1}" />
            <Button Style="{StaticResource IconButton}" Command="{Binding CloseCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0" ToolTip="Close (Esc)" AutomationProperties.Name="Close the limits">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="10" Height="10" />
            </Button>
          </Grid>
          <TextBlock Text="{x:Static vm:AgentLimitsText.MinLabel}" Margin="0,22,0,8" />
          <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding MinInterval, UpdateSourceTrigger=PropertyChanged}" Width="90" TextAlignment="Center" AutomationProperties.Name="Shortest schedule in minutes" />
            <TextBlock Text="minutes" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
          <TextBlock Text="{x:Static vm:AgentLimitsText.MinHelp}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock Text="{x:Static vm:AgentLimitsText.MaxLabel}" Margin="0,22,0,8" />
          <StackPanel Orientation="Horizontal">
            <TextBox Text="{Binding MaxJobs, UpdateSourceTrigger=PropertyChanged}" Width="90" TextAlignment="Center" AutomationProperties.Name="Most schedules an agent may have" />
            <TextBlock Text="schedules" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0" />
          </StackPanel>
          <TextBlock Text="{x:Static vm:AgentLimitsText.MaxHelp}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock Text="{Binding Error}" Foreground="{StaticResource RedBrush}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{x:Static vm:AgentLimitsText.CliLead}" Style="{StaticResource Small}" Margin="0,22,0,0" />
          <TextBlock Text="{x:Static vm:AgentLimitsText.CliCommand}" Style="{StaticResource Small}" Foreground="{StaticResource FgBrush}" Margin="0,4,0,0" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Command="{Binding CloseCommand}" MinWidth="92" AutomationProperties.Name="Cancel" />
            <Button Content="Save" Style="{StaticResource Primary}" Command="{Binding SaveCommand}" MinWidth="92" Margin="10,0,0,0" IsDefault="True" AutomationProperties.Name="Save limits" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <ContextMenu x:Key="MainMenu">
      <MenuItem Header="Show other Task Scheduler tasks" IsCheckable="True" IsChecked="{Binding ShowForeign, Mode=TwoWay}" StaysOpenOnClick="False" />
      <Separator />
      <MenuItem Header="Refresh" InputGestureText="F5" Command="{Binding RefreshCommand}" />
      <MenuItem Header="Open Task Scheduler" Command="{Binding OpenTaskSchedulerCommand}" />
      <MenuItem Header="Open run history folder" Command="{Binding OpenRunsFolderCommand}" />
      <Separator />
      <MenuItem Header="Suspend AI agents" IsChecked="{Binding AgentsSuspended, Mode=OneWay}" Command="{Binding TogglePillCommand}" AutomationProperties.AutomationId="SuspendAgentsItem" />
      <MenuItem Header="Agent activity…" Command="{Binding OpenActivityCommand}" AutomationProperties.AutomationId="AgentActivityItem" />
      <MenuItem Header="What AI agents may do…" Command="{Binding OpenLimitsCommand}" AutomationProperties.AutomationId="AgentLimitsItem" />
      <Separator />
      <MenuItem Header="Remove all Cadence schedules…" Command="{Binding RemoveAllCommand}" />
      <Separator />
      <MenuItem Header="About Cadence" Command="{Binding AboutCommand}" />
    </ContextMenu>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- [P25] The toolbar (the list only; the editor has its own bar): New, the actions on the selection, Refresh, the filter and the menu. -->
    <Border Visibility="{Binding IsListShowing, Converter={StaticResource BoolToVis}}" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="0,0,0,1" Padding="10,0,12,0">
      <Grid Height="40">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="NewButton" Style="{StaticResource ToolbarButton}" Command="{Binding NewCommand}" ToolTip="New schedule (Ctrl+N)" AutomationProperties.Name="New schedule">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" Foreground="{StaticResource BlueBrush}" Margin="0,0,7,0" /><TextBlock Text="New" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding List.RunSelectedCommand}" Margin="4,0,0,0" ToolTip="Run the selected schedules now (Ctrl+R)" AutomationProperties.Name="Run selected">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE768;" Margin="0,0,7,0" /><TextBlock Text="Run now" /></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding List.EnableSelectedCommand}" ToolTip="Enable the selected schedules" AutomationProperties.Name="Enable selected">
            <TextBlock Text="Enable" />
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding List.DisableSelectedCommand}" ToolTip="Disable the selected schedules (they stay in Task Scheduler)" AutomationProperties.Name="Disable selected">
            <TextBlock Text="Disable" />
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding List.DeleteSelectedCommand}" ToolTip="Delete the selected schedules (Del)" AutomationProperties.Name="Delete selected">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" Margin="0,0,7,0" /><TextBlock Text="Delete" /></StackPanel>
          </Button>
          <Border Width="1" Height="18" Margin="8,0" Background="{StaticResource HighlightBrush}" />
          <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshCommand}" ToolTip="Read Task Scheduler again (F5)" AutomationProperties.Name="Refresh">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" Margin="0,0,7,0" /><TextBlock Text="Refresh" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBox x:Name="FilterBox" Width="220" Text="{Binding List.FilterText, UpdateSourceTrigger=PropertyChanged}" views:TextBoxHelper.Placeholder="Filter…" ToolTip="Filter the schedules (Ctrl+F)"
                   AutomationProperties.Name="Filter" PreviewKeyDown="OnFilterKeyDown" />
          <!-- [CP-C] Only on the list: the editor has its own menu for the schedule. -->
          <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Margin="8,0,0,0" ToolTip="Menu" AutomationProperties.Name="Menu" Click="OnMenuClick">
            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE712;" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- [P23] AI agents were turned back on (by an agent, or outside Cadence): Orange, until the owner opens the menu or says "Got it". -->
    <Border Grid.Row="1" Visibility="{Binding HasAgentNote, Converter={StaticResource BoolToVis}}" Background="#1F1A17" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="0,0,0,1"
            Padding="16,0,12,0" AutomationProperties.AutomationId="AgentNote">
      <Grid Height="32" ToolTip="{Binding AgentNoteTooltip}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="M9,1.5 L17,16 H1 Z M9,7 V11.5 M9,13.6 V14" Stroke="{StaticResource OrangeBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Width="14" Height="13" Margin="0,0,10,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding AgentNoteText}" Foreground="{StaticResource OrangeBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding AgentNoteText}" AutomationProperties.HelpText="{Binding AgentNoteTooltip}" AutomationProperties.AutomationId="AgentNoteText" />
        </StackPanel>
        <Button Grid.Column="1" Content="Got it" Style="{StaticResource LinkButton}" Command="{Binding AcknowledgeNoteCommand}" VerticalAlignment="Center" AutomationProperties.Name="Got it" />
      </Grid>
    </Border>

    <!-- Content host: the list, or the editor. -->
    <Grid Grid.Row="2">
      <ContentControl Content="{Binding CurrentPage}" Focusable="False" />

      <!-- The PLUS sheet: the same template cards, centered over the list. -->
      <Grid Visibility="{Binding IsSheetOpen, Converter={StaticResource BoolToVis}}">
        <Border Background="#C0101018">
          <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding CloseSheetCommand}" />
          </Border.InputBindings>
        </Border>
        <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="40,24" MaxWidth="1000"
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Effect="{StaticResource SoftShadow}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22,26,26">
              <Grid Margin="6,0,6,18">
                <StackPanel>
                  <TextBlock Text="{Binding SheetTitle}" Style="{StaticResource Heading1}" TextWrapping="Wrap" Margin="0,0,40,0" />
                  <TextBlock Text="{Binding SheetSubtitle}" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,5,40,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Command="{Binding CloseSheetCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Close (Esc)" AutomationProperties.Name="Close">
                  <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        Width="10" Height="10" />
                </Button>
              </Grid>
              <views:TemplateCards DataContext="{Binding Cards}" />
              <views:DropArea Margin="0,16,0,0" Visibility="{Binding ShowSheetDropArea, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- A file is being dragged over the list or the sheet: the whole area becomes a drop target. -->
      <Border Visibility="{Binding ShowDropOverlay, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False" Margin="8" CornerRadius="6" Background="#E61A1B26"
              BorderBrush="{StaticResource BlueBrush}" BorderThickness="2">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Path Data="M9,0 V15 M3,9 L9,15 L15,9 M0,19 H18" Stroke="{StaticResource BlueBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Width="18" Height="20" HorizontalAlignment="Center" />
          <TextBlock Text="Drop to create a schedule for this file" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BlueBrush}" Margin="0,14,0,0" HorizontalAlignment="Center" />
          <TextBlock Text="Programs, shortcuts and scripts work: .exe, .lnk, .bat, .cmd, .ps1, .py, .js, .vbs" Style="{StaticResource Small}" Margin="0,8,0,0" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- A short confirmation or message. -->
      <Border Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" Padding="14,8"
              Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Effect="{StaticResource SoftShadow}" Cursor="Hand">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftClick" Command="{Binding DismissToastCommand}" />
        </Border.InputBindings>
        <TextBlock Text="{Binding Toast}" />
      </Border>
    </Grid>

    <!-- Render mode only (render mode, agents states): the pill's tooltip, drawn as a card, because a real tooltip popup can't be captured off-screen. -->
    <Border Grid.RowSpan="4" Visibility="{Binding ShowTooltipPreview, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,30" MaxWidth="380"
            Padding="10,7" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Effect="{StaticResource SoftShadow}" IsHitTestVisible="False">
      <TextBlock Text="{Binding PillTooltip}" TextWrapping="Wrap" FontSize="12" />
    </Border>

    <!-- [P23] Panels drawn inside the window: questions (resume agents, a stale save), Agent activity, the agent limits. Esc or a click outside closes them. -->
    <Grid Grid.RowSpan="4" Visibility="{Binding HasPanel, Converter={StaticResource BoolToVis}}">
      <Border Background="#C0101018">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePanelCommand}" />
        </Border.InputBindings>
      </Border>
      <ContentControl Content="{Binding ActivePanel}" Focusable="False" />
    </Grid>

    <!-- [P25] The status bar: counts on the left; the agent switch on the right (window level, so the switch is also there in the editor). -->
    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HighlightBrush}" BorderThickness="0,1,0,0" Padding="16,0,8,0">
      <Grid Height="24">
        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBarText}" AutomationProperties.AutomationId="StatusText" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- The build (release tag later): plain DimText, left of the other two. -->
          <TextBlock Text="{Binding VersionText}" Style="{StaticResource StatusBarText}" Margin="0,0,12,0" ToolTip="{Binding VersionTooltip}"
                     AutomationProperties.AutomationId="VersionText" />
          <!-- [P23] The agent switch: a text button, shown once the setting has been read. Click suspends; resuming asks first, in a panel. -->
          <Button Style="{StaticResource AgentSwitch}" Command="{Binding TogglePillCommand}" ToolTip="{Binding PillTooltip}" Visibility="{Binding IsPillVisible, Converter={StaticResource BoolToVis}}"
                  AutomationProperties.Name="{Binding PillText}" AutomationProperties.HelpText="{Binding PillTooltip}" AutomationProperties.AutomationId="AgentsPill" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>

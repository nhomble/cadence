<Window x:Class="Cadence.App.UI.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Cadence.App.UI.Views"
        Title="{Binding WindowTitle}" Width="1280" Height="800" MinWidth="720" MinHeight="420" WindowStartupLocation="CenterScreen">
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}" />
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusFilterCommand}" />
    <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCurrentCommand}" />
    <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RunNowCurrentCommand}" />
    <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding BackCommand}" />
  </Window.InputBindings>
  <views:MainView x:Name="Main" />
</Window>
